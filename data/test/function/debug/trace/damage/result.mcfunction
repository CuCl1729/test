#> test:debug/trace/damage/result
# @s = ダメージを受けた対象。test:damage/の最後(HP減算後・撃破処理の前)に、ダメージログがオンのときだけ呼ばれる。
# 値はtest:damage/が計算に使ったスコアをそのまま読む(#pene_total/#effective_pene/#victim test.status.defなど)

execute if score #crit_hit test.temporary matches 1 run tellraw @a [{text:"[ダメージ] ",color:gold},{selector:"@s"},{text:"  会心 ",color:gray},{score:{name:"#crit_roll",objective:"test.temporary"},color:white},{text:" ≦ ",color:gray},{score:{name:"#damage",objective:"test.status.crit_rate"},color:white},{text:" → 発生",color:yellow}]
execute if score #crit_hit test.temporary matches 0 run tellraw @a [{text:"[ダメージ] ",color:gold},{selector:"@s"},{text:"  会心 ",color:gray},{score:{name:"#crit_roll",objective:"test.temporary"},color:white},{text:" > ",color:gray},{score:{name:"#damage",objective:"test.status.crit_rate"},color:white},{text:" → なし",color:gray}]
tellraw @a [{text:"  防御: ",color:gray},{text:"DEF "},{score:{name:"@s",objective:"test.status.def"},color:white},{text:" / 貫通合計 "},{score:{name:"#pene_total",objective:"test.temporary"},color:white},{text:" / 有効貫通 "},{score:{name:"#effective_pene",objective:"test.temporary"},color:white},{text:"% / 通過倍率 "},{score:{name:"#victim",objective:"test.status.def"},color:white},{text:"%"}]
tellraw @a [{text:"  最終: ",color:gray},{text:"物理 "},{score:{name:"#victim",objective:"test.physics_damage"},color:white},{text:" 火 "},{score:{name:"#victim",objective:"test.fire_damage"},color:white},{text:" 水 "},{score:{name:"#victim",objective:"test.water_damage"},color:white},{text:" 木 "},{score:{name:"#victim",objective:"test.wood_damage"},color:white},{text:" 金 "},{score:{name:"#victim",objective:"test.metal_damage"},color:white},{text:" 土 "},{score:{name:"#victim",objective:"test.earth_damage"},color:white},{text:" → HP "},{score:{name:"@s",objective:"test.status.hp"},color:white},{text:"/"},{score:{name:"@s",objective:"test.status.hp_max"},color:white}]
