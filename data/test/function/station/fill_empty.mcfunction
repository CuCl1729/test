#> test:station/fill_empty
# @s = ステーションのマーカー(test:station/tick の最後で毎tick。実行位置は樽)。樽の空いているスロットを、名前も説明も出ない薄灰色の板ガラス
# (station_ui。取られても station/tick の回収で手元から消える)で埋めて、物を置けないようにする。
# 埋めないのは data.station.keep にあるスロット(プレイヤーが物を置くスロット。モードの keep と、切り替えボタン 20・作るボタン 26)だけ。
# 描き直すモードは、置く前にそのスロットを消すので、板ガラスとぶつからない(描き直した次のtickまでに埋まる)

data modify storage test: station_work.keep set from entity @s data.station.keep
# 前は灰色の板ガラスで埋めていたので、残っていれば消して薄灰色で埋め直す
data remove block ~ ~ ~ Items[{id:"minecraft:gray_stained_glass_pane",components:{"minecraft:custom_data":{test:{station_ui:1b}}}}]
execute unless data storage test: station_work.keep.s0 unless data block ~ ~ ~ Items[{Slot:0b}] run data modify block ~ ~ ~ Items append value {Slot:0b,id:"minecraft:light_gray_stained_glass_pane",count:1,components:{"minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{test:{station_ui:1b}}}}
